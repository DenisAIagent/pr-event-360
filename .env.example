# Copiez ce fichier vers .env. Ne commitez jamais .env ni une valeur réelle.

# ─── PostgreSQL local ───────────────────────────────────────────────
PR360_DEV_DB_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgres://prevent:replace-with-a-local-random-password@localhost:5432/pr_event_360

# ─── Serveur et URLs publiques ─────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ─── Session back-office ───────────────────────────────────────────
# Minimum 32 caractères. Exemple : openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# 32 octets encodés en base64. Chiffre les intégrations enregistrées en base.
# Exemple : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Bootstrap production, lu par start:prod. Laisser vide après création si non nécessaire.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# Seed manuel de développement : npm --workspace server run seed
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=Attaché de presse

# ─── Domaines dédiés ───────────────────────────────────────────────
# Cible CNAME affichée aux clients ; repli sur le host PUBLIC_BASE_URL.
CUSTOM_DOMAIN_TARGET=
# Domaine wildcard de la plateforme, sans protocole, ex. prevent360.app.
PLATFORM_BASE_DOMAIN=

# ─── Google Identity ───────────────────────────────────────────────
# ID client public. Sans valeur, le bouton Google est masqué.
GOOGLE_CLIENT_ID=

# ─── Stripe ────────────────────────────────────────────────────────
# Les trois valeurs sont nécessaires pour activer l'inscription payante.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ─── Notifications ─────────────────────────────────────────────────
# Garder simulation tant que les parcours n'ont pas été validés.
NOTIFICATIONS_MODE=simulation
EMAIL_PROVIDER=brevo
SMS_PROVIDER=twilio

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PR Event 360
BREVO_SMS_SENDER=PREvent

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Preset signé, unsigned=false, max_file_size <= 209715200.
CLOUDINARY_UPLOAD_PRESET=pr-event-360-secure

# ─── Observabilité ─────────────────────────────────────────────────
SENTRY_DSN=
# Variable Vite lue au build du client, sans PII par défaut.
VITE_SENTRY_DSN=
